<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Define where logs will be stored relative to your project folder -->
    <property name="LOGS_DIR" value="./logs" />

    <!-- 1. Console Appender (For neat, color-coded terminal outputs) -->
    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %magenta([%thread]) %highlight(%-5level) %cyan(%logger{36}) [User: %yellow(%X{username})] -
                %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. Rolling File Appender (Critical for HIPAA audits: writes logs to disk, rotates daily, keeps 30 days history) -->
    <appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS_DIR}/coreris-audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Daily rollover: creates coreris-2026-08-05.log -->
            <fileNamePattern>${LOGS_DIR}/archived/coreris-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory> <!-- Retain archived logs for 30 days -->
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} [User: %X{username}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Set root log level to INFO and connect both appenders -->
    <root level="INFO">
        <appender-ref ref="Console" />
        <appender-ref ref="RollingFile" />
    </root>
</configuration>